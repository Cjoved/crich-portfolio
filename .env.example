# Contact form / email forwarding (optional — only needed if you wire up a contact form provider)
# RESEND_API_KEY=

# Public site URL for Open Graph / metadata (set this in Vercel → Settings → Environment Variables)
# Without it, OG tags fall back to the Vercel deployment URL automatically after the layout fix.
# Example: https://crich-portfolio.vercel.app  or your custom domain
NEXT_PUBLIC_SITE_URL=https://crich-portfolio.vercel.app
